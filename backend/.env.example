DEMO_MODE=true
DATABASE_URL=sqlite:///./superped_demo.db
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_32_CARACTERES_OU_MAIS
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Opcional: expiração do token em minutos (padrão 60).
JWT_EXPIRE_MINUTES=60
# Somente local: permite `python -m app.seed --reset` em SQLite.
ALLOW_DB_RESET=false

# API Barô da Mauá, compatível com Chat Completions (somente backend).
# Configure a chave com scripts/configure_baro.py, que usa entrada oculta.
AI_API_URL=https://ia.maua.br/api/v1
AI_API_KEY=
BARO_API_KEY=
AI_PROVIDER_LABEL=Pendi
AI_API_MODEL=google/gemma-3-27b
AI_ALLOWED_HOSTS=ia.maua.br
# Permitir HTTP apenas em integração local de desenvolvimento, se necessário.
AI_ALLOW_HTTP=false
# Opcional: pasta LOCAL contendo o modelo Whisper preparado por scripts/setup_speech.py.
WHISPER_MODEL_PATH=
